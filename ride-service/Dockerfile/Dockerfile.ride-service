# =====================================================
# Dockerfile pour Ride Service
# Framework d'acteurs distribués - CY Land
# =====================================================

# Stage 1: Build
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /app

# Copier les fichiers Maven
COPY pom.xml .
COPY actor-framework/pom.xml actor-framework/
COPY eureka-server/pom.xml eureka-server/
COPY gate-service/pom.xml gate-service/
COPY ride-service/pom.xml ride-service/

# Installer Maven
RUN apk add --no-cache maven

# Télécharger les dépendances (cache layer)
RUN mvn dependency:go-offline -B -pl ride-service -am

# Copier le code source
COPY actor-framework/src actor-framework/src
COPY ride-service/src ride-service/src

# Compiler l'application
RUN mvn clean package -DskipTests -pl ride-service -am

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="CY Land Team"
LABEL description="Ride Service - Microservice de gestion des attractions du parc"
LABEL version="1.0.0"

WORKDIR /app

# Créer un utilisateur non-root pour la sécurité
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Créer les répertoires nécessaires
RUN mkdir -p /app/logs/ride-service/actors && \
    chown -R appuser:appgroup /app

# Copier le JAR depuis le stage de build
COPY --from=builder /app/ride-service/target/*.jar app.jar

# Changer vers l'utilisateur non-root
USER appuser

# Variables d'environnement par défaut
ENV JAVA_OPTS="-Xmx512m -Xms256m" \
    SERVER_PORT=8082 \
    SPRING_PROFILES_ACTIVE=docker \
    EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/ \
    SPRING_RABBITMQ_HOST=rabbitmq

# Exposer le port
EXPOSE 8082

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8082/actuator/health || exit 1

# Point d'entrée
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
