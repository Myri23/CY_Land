# =====================================================
# Dockerfile pour Eureka Server
# Framework d'acteurs distribués - CY Land
# =====================================================

# Stage 1: Build
FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /app

# Copier les fichiers Maven
COPY pom.xml .
COPY actor-framework/pom.xml actor-framework/
COPY eureka-server/pom.xml eureka-server/
COPY gate-service/pom.xml gate-service/
COPY ride-service/pom.xml ride-service/

# Installer Maven
RUN apk add --no-cache maven

# Télécharger les dépendances (cache layer)
RUN mvn dependency:go-offline -B -pl eureka-server

# Copier le code source
COPY eureka-server/src eureka-server/src

# Compiler l'application
RUN mvn clean package -DskipTests -pl eureka-server

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="CY Land Team"
LABEL description="Eureka Server - Service Discovery pour les microservices"
LABEL version="1.0.0"

WORKDIR /app

# Créer un utilisateur non-root pour la sécurité
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copier le JAR depuis le stage de build
COPY --from=builder /app/eureka-server/target/*.jar app.jar

# Changer vers l'utilisateur non-root
USER appuser

# Variables d'environnement par défaut
ENV JAVA_OPTS="-Xmx256m -Xms128m" \
    SERVER_PORT=8761

# Exposer le port
EXPOSE 8761

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8761/actuator/health || exit 1

# Point d'entrée
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
